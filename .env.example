# GEMA AI - ENV untuk Railway
# Set semua variable ini di Railway Dashboard -> Variables
# Lokal: buat file .env atau set di system env, atau buat config/local.php

# Provider CommandCode (OpenAI Chat Completions compatible)
# Endpoint lihat: https://api.commandcode.ai/provider/v1/chat/completions
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_URL=https://api.commandcode.ai/provider/v1/chat/completions
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash

# Alternatif: fallback ke DeepSeek native (jika credit sudah isi)
# DEEPSEEK_API_KEY=sk-... (DeepSeek)
# DEEPSEEK_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_MODEL=deepseek-chat

# Database - Railway MySQL auto-inject:
# MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
# Jika manual, isi di sini:
MYSQLHOST=
MYSQLPORT=3306
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=db_gema_ai

# Alternative names (support semua):
# MYSQL_HOST, DB_HOST, DATABASE_HOST
