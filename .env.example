# ============================================================
#  GEMA AI - Environment Variables (Railway / server)
#  Set di Railway -> service gema -> Variables
# ============================================================

# --- Provider AI (OpenRouter - key milik client) ---
# Set nilai ASLI di Railway -> service gema -> Variables.
# File ini contoh saja, JANGAN isi key asli di sini.
DEEPSEEK_API_KEY=YOUR_OPENROUTER_API_KEY
DEEPSEEK_URL=https://openrouter.ai/api/v1/chat/completions
DEEPSEEK_MODEL=deepseek/deepseek-chat

# Budget token output. Dipertahankan 64000 sebagai batas atas agar JSON
# modul penuh tidak terpotong (finish_reason: length).
DEEPSEEK_MAX_TOKENS=64000

# --- MySQL (Railway inject otomatis kalau pakai MySQL plugin) ---
MYSQLHOST=${{my-mysql.MYSQLHOST}}
MYSQLPORT=${{my-mysql.MYSQLPORT}}
MYSQLUSER=${{my-mysql.MYSQLUSER}}
MYSQLPASSWORD=${{my-mysql.MYSQLPASSWORD}}
MYSQLDATABASE=${{my-mysql.MYSQLDATABASE}}
