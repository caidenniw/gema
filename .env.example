# ============================================================
#  GEMA AI - Environment Variables (Railway / server)
#  Set di Railway -> service gema -> Variables
# ============================================================
#
#  ADA DUA MODE. Pilih salah satu.
#
#  ------------------------------------------------------------
#  MODE 1 - DIRECT (key plan GOAT / Pro / Max / Team / Provider)
#  ------------------------------------------------------------
#  DEEPSEEK_API_KEY = user_xxxxxxxx
#  DEEPSEEK_URL     = https://api.commandcode.ai/provider/v1/chat/completions
#  DEEPSEEK_MODEL   = deepseek/deepseek-v4-flash
#
#  ------------------------------------------------------------
#  MODE 2 - PROXY (key plan Go, lewat service cc-proxy)
#  ------------------------------------------------------------
#  DEEPSEEK_API_KEY = proxy-managed
#  DEEPSEEK_URL     = http://cc-proxy.railway.internal:8080/v1/chat/completions
#  DEEPSEEK_MODEL   = deepseek/deepseek-v4-flash
#
#  Catatan: plan Go TIDAK punya akses ke /provider/v1 (403
#  upgrade_required). Kalau pakai key plan Go, wajib MODE 2.

DEEPSEEK_API_KEY=YOUR_COMMANDCODE_API_KEY
DEEPSEEK_URL=https://api.commandcode.ai/provider/v1/chat/completions
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash

# Budget token output. Model deepseek-v4-flash adalah model reasoning:
# sebagian besar budget habis untuk "berpikir" sebelum menulis konten.
# Dengan 12000, JSON modul terpotong (finish_reason: length).
# Max output model ini 393.216 token.
DEEPSEEK_MAX_TOKENS=64000

# --- MySQL (Railway otomatis inject kalau pakai MySQL plugin) ---
MYSQLHOST=${{my-mysql.MYSQLHOST}}
MYSQLPORT=${{my-mysql.MYSQLPORT}}
MYSQLUSER=${{my-mysql.MYSQLUSER}}
MYSQLPASSWORD=${{my-mysql.MYSQLPASSWORD}}
MYSQLDATABASE=${{my-mysql.MYSQLDATABASE}}
