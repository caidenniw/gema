# ============================================================
#  GEMA AI - Environment Variables (Railway / server)
#  Set di Railway -> service gema -> Variables
# ============================================================

# --- Provider AI (CommandCode Provider API) ---
# Key harus dari akun dengan API access: GOAT / Pro / Max / Team / Provider.
# Key plan Go akan ditolak (403 upgrade_required) di endpoint ini.
DEEPSEEK_API_KEY=YOUR_COMMANDCODE_API_KEY
DEEPSEEK_URL=https://api.commandcode.ai/provider/v1/chat/completions
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash

# Budget token output. deepseek-v4-flash adalah model reasoning: sebagian
# budget dipakai untuk "berpikir" sebelum menulis konten. Dengan 12000,
# JSON modul terpotong (finish_reason: length). Max output model: 393.216.
DEEPSEEK_MAX_TOKENS=64000

# --- MySQL (Railway inject otomatis kalau pakai MySQL plugin) ---
MYSQLHOST=${{my-mysql.MYSQLHOST}}
MYSQLPORT=${{my-mysql.MYSQLPORT}}
MYSQLUSER=${{my-mysql.MYSQLUSER}}
MYSQLPASSWORD=${{my-mysql.MYSQLPASSWORD}}
MYSQLDATABASE=${{my-mysql.MYSQLDATABASE}}
